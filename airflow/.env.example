# Copy this file to .env and replace generated-secret placeholders.
# Never commit .env. This is a local Docker Compose development environment.

AIRFLOW_VERSION=3.3.1
AIRFLOW_IMAGE_NAME=india-aqi-airflow:3.3.1
AIRFLOW_UID=50000

# Generated by init-airflow-env.ps1
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_GENERATED_JWT_SECRET

# Local-only database password (hex characters, safe in a PostgreSQL URL).
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD

# Local Airflow UI administrator credentials.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Existing AWS IAM Identity Center profile. Authenticate on Windows before triggering AWS tasks.
AWS_PROFILE=india-aqi-admin
AWS_DEFAULT_REGION=ap-south-1

# Set this to the existing CPCB/data.gov.in key locally. Never share or commit it.
DATA_GOV_API_KEY=
